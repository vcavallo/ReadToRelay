{
  "manifest_version": 3,
  "name": "ReadToRelay",
  "version": "1.0",
  "description": "Extract reader mode content and post to Nostr as longform markdown",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "readtorelay@vinneycavallo.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity"]
      }
    }
  },
  "homepage_url": "https://github.com/vcavallo/ReadToRelay",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
